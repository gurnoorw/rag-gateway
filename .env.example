# Copy to .env (gitignored) and fill in. Never commit .env.
# Empty values fall back to the defaults in docker-compose.yml / application.yml.

# Postgres (local only)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Redis
REDIS_HOST=
REDIS_PORT=

# Providers. Gateway-specific names on purpose (DECISIONS.md D-32): other tools read
# ANTHROPIC_BASE_URL / ANTHROPIC_API_KEY, and the gateway must not pick those up by accident.
# The Claude key is a secret: set it only in your own .env.
GATEWAY_CLAUDE_API_KEY=
GATEWAY_CLAUDE_BASE_URL=
GATEWAY_OLLAMA_BASE_URL=

# Grafana (obs profile)
GRAFANA_ADMIN_PASSWORD=
