# Copy to .env (gitignored) and fill in. Never commit .env.
# Empty values fall back to the defaults in docker-compose.yml / application.yml.

# Postgres (local only)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Redis
REDIS_HOST=
REDIS_PORT=

# Providers. The Anthropic key is a secret: set it only in your own .env.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OLLAMA_BASE_URL=

# Grafana (obs profile)
GRAFANA_ADMIN_PASSWORD=
